 export function compileDirectoryPlugin(directory: string, version: string, builtinId?: string) {
+  // Only immutable built-in plugins may use bundles generated by the Nix build.
+  if (builtinId !== undefined && directory.startsWith("/nix/store/")) {
+    const { version: builtVersion, ...bundles } = JSON.parse(
+      readFileSync(new URL("nix-bundles.json", pathToFileURL(directory + "/")), "utf8"),
+    );
+    if (builtVersion !== version || bundles.manifest.id !== builtinId) {
+      throw new Error(`Precompiled built-in plugin ${builtinId} does not match this build`);
+    }
+    return Promise.resolve(bundles);
+  }
   return runCompilerTask({ kind: "directory", directory, version, builtinId });
 }
