context platform=ios timeout=120000 retries=0
env APP_ID=sh.paseo.debug

# Preconditions: this checkout's Metro; disposable fixture host; a minimized BTW thread in
# the owning chat. Enable the software keyboard. Never attach to the main daemon.
# Save runner screenshots/bounds with the command's --artifacts-dir. Inspect keyboard-visible
# composer/send bounds, bottom safe-area clearance, selection and sheet hit targets.
open "${APP_ID}"
wait "id=\"btw-chip\"" 30000
press "id=\"btw-chip\""
wait "id=\"btw-sheet-chip\"" 10000
press "id=\"btw-composer\""
fill "id=\"btw-composer\"" "HOLD_BTW Native keyboard smoke 日本語"
is visible "id=\"btw-send\""
is visible "id=\"btw-sheet-chip\""
longpress "id=\"btw-composer\"" 600
press "id=\"btw-sheet-chip\""
wait "id=\"btw-chip\"" 10000
press "id=\"btw-chip\""
wait "id=\"btw-sheet-chip\"" 10000
is visible "id=\"btw-composer\""
press "id=\"btw-send\""
wait "id=\"btw-stop\"" 10000
press "id=\"btw-sheet-chip\""
wait "id=\"btw-chip\"" 10000
press "id=\"btw-chip\""
wait "id=\"btw-sheet-chip\"" 10000
press "id=\"btw-minimize\""
wait "id=\"btw-chip\"" 10000
press "id=\"btw-chip\""
wait "id=\"btw-sheet-chip\"" 10000
